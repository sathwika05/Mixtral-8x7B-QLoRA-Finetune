# --- Server-only. Never prefix these with NEXT_PUBLIC_. ---

# API Gateway invoke URL fronting Lambda -> SageMaker endpoint. Required.
MIXTRAL_API_URL=

# Optional API key, sent as the header named by MIXTRAL_API_KEY_HEADER.
MIXTRAL_API_KEY=
MIXTRAL_API_KEY_HEADER=x-api-key

# Abort timeout for a single inference request, in milliseconds.
MIXTRAL_TIMEOUT_MS=60000

# Request envelope field names, in case the Lambda contract changes.
MIXTRAL_PROMPT_FIELD=prompt
MIXTRAL_PARAMS_FIELD=parameters

# Leave false until the deployed Lambda is confirmed to accept generation
# parameters. While false the app sends { prompt } only and the generation
# controls render disabled and labeled "Backend support pending".
MIXTRAL_SUPPORTS_PARAMETERS=false

# --- Display labels only. Non-secret. ---
NEXT_PUBLIC_MODEL_LABEL=Mixtral-8x7B-v0.1 · QLoRA Fine-Tuned
NEXT_PUBLIC_AWS_REGION_LABEL=

# Absolute site origin, used to build Open Graph and canonical URLs.
# Must be set at deploy time or link previews will point at localhost.
NEXT_PUBLIC_SITE_URL=
